<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"                Version="17.8.0" />
    <PackageReference Include="xunit"                                 Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio"             Version="2.5.4" />
    <PackageReference Include="FluentAssertions"                      Version="6.12.0" />
    <PackageReference Include="Moq"                                   Version="4.20.70" />
    <PackageReference Include="Testcontainers.PostgreSql"             Version="3.10.0" />
    <PackageReference Include="Respawn"                               Version="6.2.1" />
    <!-- Tests HTTP: levanta el stack completo de ASP.NET Core en memoria -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing"      Version="8.0.0" />
    <!-- Versiones alineadas con TurneroApp.Api para evitar NU1605 downgrade -->
    <PackageReference Include="Microsoft.IdentityModel.Tokens"        Version="8.0.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt"       Version="8.0.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- ASP.NET Core APIs (AddRateLimiter, etc.) disponibles en el test runner -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Infrastructure trae EF Core, AppDbContext, migrations y repositorios -->
    <ProjectReference Include="..\..\src\Infrastructure\TurneroApp.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Application\TurneroApp.Application.csproj" />
    <ProjectReference Include="..\..\src\Domain\TurneroApp.Domain.csproj" />
    <!-- Api: necesario para WebApplicationFactory<Program> en tests HTTP -->
    <ProjectReference Include="..\..\src\Api\TurneroApp.Api.csproj">
      <Properties>UseAppHost=false</Properties>
    </ProjectReference>
  </ItemGroup>
</Project>
